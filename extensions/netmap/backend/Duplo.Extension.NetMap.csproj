<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Backend for the Network Map extension — compiled by the duplo-extension-dev skill with `dotnet publish`.
    The build skill:
      1. GET  {host}/v1/aiservicedesk/extensions/sdk-version  -> -p:DuploSdkVersion=<value>
      2. GET  {host}/v1/aiservicedesk/extensions/sdk-bundle   -> unzip into ./sdk-packages
      3. dotnet publish -c Release -o <dist>/backend  (restores SDK from ./sdk-packages via nuget.config)
    The SDK is referenced compile-only (ExcludeAssets="runtime") and exact-pinned to the running host
    version, so the extension ships only its own DLL + genuinely third-party deps and shares the host's
    SDK type identity at load time (ExtensionLoadContext resolves SDK assemblies from the host).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
    <!-- Overridden by the build skill: -p:DuploSdkVersion=<value from sdk-version> -->
    <DuploSdkVersion Condition="'$(DuploSdkVersion)' == ''">1.0.0</DuploSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Duplocloud.AiHelpdesk.Sdk" Version="[$(DuploSdkVersion)]" ExcludeAssets="runtime" />
    <!-- VPC/subnet/security-group/ENI reads, all read-only Describe* calls, no mutation. Float to the
         latest 4.x rather than pin an exact version, matching the SDK's own AWSSDK.Core 4.x transitive
         pin (see extensions/rdsupgrade's history for why an explicit AWSSDK.Core pin causes a conflict). -->
    <PackageReference Include="AWSSDK.EC2" Version="4.*" />
    <!-- Load balancer + DNS reads for the public/internal URL cross-reference, same read-only Describe*/List*
         pattern and the same floating-4.x reasoning as AWSSDK.EC2 above. -->
    <PackageReference Include="AWSSDK.ElasticLoadBalancingV2" Version="4.*" />
    <PackageReference Include="AWSSDK.Route53" Version="4.*" />
    <!-- Classic ELB, Network Firewall and Route53 Resolver reads for the v1 collectors - same read-only,
         floating-4.x reasoning as the packages above. -->
    <PackageReference Include="AWSSDK.ElasticLoadBalancing" Version="4.*" />
    <PackageReference Include="AWSSDK.NetworkFirewall" Version="4.*" />
    <PackageReference Include="AWSSDK.Route53Resolver" Version="4.*" />
  </ItemGroup>

</Project>
